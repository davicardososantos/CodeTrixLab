// Cloudflare Workers servindo só arquivos estáticos (o que o Astro gera em dist/).
{
	"name": "codetrixlab",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"routes": [
		{ "pattern": "blog.codetrix.com.br", "custom_domain": true }
	]
}
