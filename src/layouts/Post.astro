---
import Data from '../components/Data.astro';
import IconePilar from '../components/IconePilar.astro';
import { AUTOR, NIVEIS, PILARES } from '../consts';
import { type Post, slugDaTag, slugDoPost } from '../lib/posts';
import Base from './Base.astro';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { titulo, descricao, publicado, atualizado, validoEm, pilar, tags, nivel, rascunho } = post.data;
---

<Base titulo={titulo} descricao={descricao} tipo="article" publicado={publicado} imagem={`/og/${slugDoPost(post)}.png`}>
	<article class="post">
		<header class="post-cabecalho">
			{rascunho && <p class="aviso-rascunho">Rascunho: só aparece no seu PC (npm run dev).</p>}
			<p class="post-pilar">
				<a href={`/pilares/${pilar}/`}>
					<IconePilar pilar={pilar} tamanho={18} />
					{PILARES[pilar].nome}
				</a>
			</p>
			<h1>{titulo}</h1>
			<p class="post-descricao">{descricao}</p>
			<dl class="post-datas">
				<div>
					<dt>Publicado em</dt>
					<dd><Data data={publicado} /></dd>
				</div>
				{
					atualizado && (
						<div>
							<dt>Atualizado em</dt>
							<dd><Data data={atualizado} /></dd>
						</div>
					)
				}
				<div>
					<dt>Informação válida em</dt>
					<dd><Data data={validoEm} /></dd>
				</div>
				<div>
					<dt>Nível</dt>
					<dd>{NIVEIS[nivel]}</dd>
				</div>
			</dl>
		</header>

		<div class="conteudo">
			<slot />
		</div>

		<footer class="post-rodape">
			{
				tags.length > 0 && (
					<p class="post-tags">
						{tags.map((tag) => (
							<a href={`/tags/${slugDaTag(tag)}/`}>#{tag}</a>
						))}
					</p>
				)
			}
			<a class="autor" href="/sobre/">
				<img src="/img/davi-cardoso.webp" alt="" width="56" height="56" loading="lazy" />
				<span>
					<strong>Escrito por {AUTOR}</strong>
					<span>Programador, com IA e automação no dia a dia. Mais sobre mim →</span>
				</span>
			</a>
		</footer>
	</article>
</Base>

<script>
	// Botão de copiar em cada bloco de código
	for (const pre of document.querySelectorAll<HTMLPreElement>('.conteudo pre.astro-code')) {
		const caixa = document.createElement('div');
		caixa.className = 'codigo';
		const botao = document.createElement('button');
		botao.type = 'button';
		botao.className = 'copiar';
		botao.textContent = 'Copiar';
		botao.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '');
				botao.textContent = 'Copiado';
			} catch {
				botao.textContent = 'Não deu';
			}
			setTimeout(() => (botao.textContent = 'Copiar'), 1500);
		});
		pre.replaceWith(caixa);
		caixa.append(pre, botao);
	}

	// Diagramas em Mermaid: a biblioteca só é baixada quando o post tem diagrama
	const blocos = [...document.querySelectorAll<HTMLElement>('.conteudo code.language-mermaid')].map(
		(code) => code.closest('pre') ?? code,
	);
	if (blocos.length > 0) {
		const { default: mermaid } = await import('mermaid');
		const diagramas = blocos.map((bloco) => {
			const div = document.createElement('div');
			div.className = 'diagrama';
			div.dataset.fonte = bloco.textContent ?? '';
			bloco.replaceWith(div);
			return div;
		});
		const desenhar = async () => {
			const escuro = document.documentElement.dataset.tema === 'escuro';
			mermaid.initialize({
				startOnLoad: false,
				theme: escuro ? 'dark' : 'default',
				themeVariables: { fontFamily: getComputedStyle(document.body).fontFamily },
			});
			for (const div of diagramas) {
				div.removeAttribute('data-processed');
				div.textContent = div.dataset.fonte ?? '';
			}
			await mermaid.run({ nodes: diagramas });
		};
		await desenhar();
		// Redesenha quando a pessoa troca o tema
		new MutationObserver(desenhar).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-tema'],
		});
	}
</script>
