---
const caminho = Astro.url.pathname;
const links = [
	{ href: '/pilares/', texto: 'Pilares' },
	{ href: '/agora/', texto: 'Agora' },
	{ href: '/sobre/', texto: 'Sobre' },
];
---

<header class="cabecalho">
	<a class="marca" href="/" aria-label="CodeTrix Lab, página inicial">
		<span class="marca-sinal" aria-hidden="true">&lt;/&gt;</span>
		<span>CodeTrix <strong>Lab</strong></span>
	</a>
	<nav aria-label="Principal">
		{
			links.map(({ href, texto }) => (
				<a href={href} aria-current={caminho.startsWith(href) ? 'page' : undefined}>
					{texto}
				</a>
			))
		}
		<button class="botao-tema" type="button" aria-label="Trocar entre tema claro e escuro">
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle>
				<path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"></path>
			</svg>
		</button>
	</nav>
</header>

<script>
	document.querySelector('.botao-tema')?.addEventListener('click', () => {
		const novo = document.documentElement.dataset.tema === 'escuro' ? 'claro' : 'escuro';
		document.documentElement.dataset.tema = novo;
		try {
			localStorage.setItem('tema', novo);
		} catch {}
	});
</script>
