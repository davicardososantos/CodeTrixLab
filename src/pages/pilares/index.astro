---
import CartoesPilares from '../../components/CartoesPilares.astro';
import Base from '../../layouts/Base.astro';
import { postsPublicados } from '../../lib/posts';

const posts = await postsPublicados();
---

<Base titulo="Pilares" descricao="Os assuntos do CodeTrix Lab, separados em seis pilares.">
	<header class="pagina-cabecalho">
		<p class="rotulo">// pilares</p>
		<h1>Os assuntos do blog</h1>
	</header>
	<CartoesPilares posts={posts} />
	<p class="secao"><a class="link-seta" href="/tags/">Ver todas as tags →</a></p>
</Base>
